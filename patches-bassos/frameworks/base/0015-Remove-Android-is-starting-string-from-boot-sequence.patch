From: Jon West <electrikjesus@gmail.com>
Date: Wed, 15 Nov 2023 13:41:06 -0500
Subject: [PATCH 15/42] Remove Android is starting string from boot sequence

---
 core/res/res/values/strings.xml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/res/res/values/strings.xml b/core/res/res/values/strings.xml
index ea0b1811539c..69d4b95ddfc2 100644
--- a/core/res/res/values/strings.xml
+++ b/core/res/res/values/strings.xml
@@ -3470,13 +3470,13 @@
     <string name="android_upgrading_title" product="device">Device is updating\u2026</string>
 
     <!-- [CHAR LIMIT=40] Title of dialog that is shown when system is starting. -->
-    <string name="android_start_title" product="default">Phone is starting\u2026</string>
+    <string name="android_start_title" product="default">\u2026</string>
     <!-- [CHAR LIMIT=40] Title of dialog that is shown when system is starting. -->
-    <string name="android_start_title" product="automotive">Android is starting\u2026</string>
+    <string name="android_start_title" product="automotive">\u2026</string>
     <!-- [CHAR LIMIT=40] Title of dialog that is shown when system is starting. -->
-    <string name="android_start_title" product="tablet">Device is starting\u2026</string>
+    <string name="android_start_title" product="tablet">\u2026</string>
     <!-- [CHAR LIMIT=40] Title of dialog that is shown when system is starting. -->
-    <string name="android_start_title" product="device">Device is starting\u2026</string>
+    <string name="android_start_title" product="device">\u2026</string>
 
     <!-- [CHAR LIMIT=NONE] Message shown in upgrading dialog when doing an fstrim. -->
 
