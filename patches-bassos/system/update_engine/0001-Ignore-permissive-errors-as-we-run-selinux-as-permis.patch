From: electrikjesus <electrikjesus@gmail.com>
Date: Thu, 11 Apr 2024 10:36:35 -0400
Subject: [PATCH] Ignore permissive errors as we run selinux as permissive.

Change-Id: I8dcf942493706ccf866bb808426b2a24426c64aa
---
 payload_consumer/postinstall_runner_action.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/payload_consumer/postinstall_runner_action.cc b/payload_consumer/postinstall_runner_action.cc
index 7913f69e..74037462 100644
--- a/payload_consumer/postinstall_runner_action.cc
+++ b/payload_consumer/postinstall_runner_action.cc
@@ -229,7 +229,7 @@ bool PostinstallRunnerAction::MountPartition(
     // Switch to a permissive domain
     if (setexeccon("u:r:backuptool:s0")) {
       LOG(ERROR) << "Failed to set backuptool context";
-      return false;
+      // return false;
     }
 
     // Run backuptool script
@@ -241,7 +241,7 @@ bool PostinstallRunnerAction::MountPartition(
     // Switch back to update_engine domain
     if (setexeccon(nullptr)) {
       LOG(ERROR) << "Failed to set update_engine context";
-      return false;
+      // return false;
     }
   } else {
     LOG(INFO) << "Skipping backuptool scripts";
