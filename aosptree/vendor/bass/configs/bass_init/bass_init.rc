service logmonster /system/bin/logwrapper /system/bin/logmonster.sh all /sdcard/Documents
    user root
    group root
    seclabel u:r:init:s0
    disabled
    oneshot

on post-fs
    exec u:r:init:s0 -- /system/bin/logwrapper /system/bin/sh /vendor/etc/bass_init/bass_init.sh init

on property:sys.boot_completed=1
    exec u:r:init:s0 -- /system/bin/logwrapper /system/bin/sh /vendor/etc/bass_init/bass_init.sh bootcomplete

on property:net.dns1=*
    exec u:r:init:s0 -- /system/bin/logwrapper /system/bin/sh /vendor/etc/bass_init/bass_init.sh netconsole
