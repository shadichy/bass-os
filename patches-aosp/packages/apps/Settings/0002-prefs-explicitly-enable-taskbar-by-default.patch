Date: Sat, 1 Jun 2024 23:07:38 -0400
Subject: [PATCH 2/2] prefs: explicitly enable taskbar by default

---
 res/xml/button_settings.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/res/xml/button_settings.xml b/res/xml/button_settings.xml
index e974cadc26..2b08f1efde 100644
--- a/res/xml/button_settings.xml
+++ b/res/xml/button_settings.xml
@@ -42,8 +42,8 @@
         android:title="@string/navigation_bar_category" >
 
         <SwitchPreference
-                android:key="enable_taskbar"
-                android:title="@string/navigation_bar_enable_taskbar_title" />
+            android:key="enable_taskbar" android:defaultValue="true"
+            android:title="@string/navigation_bar_enable_taskbar_title" />
 
         <com.bliss.support.preferences.SystemSettingSwitchPreference
             android:key="navigation_bar_menu_arrow_keys"
-- 
