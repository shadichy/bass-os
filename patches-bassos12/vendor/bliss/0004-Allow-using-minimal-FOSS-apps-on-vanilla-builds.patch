From bd791e49e181a75c981503f66059cacd01612450 Mon Sep 17 00:00:00 2001
From: electrikjesus <electrikjesus@gmail.com>
Date: Wed, 6 Mar 2024 15:55:13 -0500
Subject: [PATCH 04/10] Allow using minimal FOSS apps on vanilla builds

---
 config/common.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/config/common.mk b/config/common.mk
index 8add8f92..32781b14 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -216,6 +216,12 @@ endif
 ifeq ($(BLISS_BUILD_VARIANT), foss)
 $(call inherit-product, vendor/foss/foss.mk)
 endif
+# We also make a minimal FOSS apps variant that only includes Neo-Store
+ifeq ($(BLISS_BUILD_VARIANT), vanilla)
+ifeq ("$(USE_FOSSAPPS)","true")
+$(call inherit-product, vendor/foss/foss.mk)
+endif
+endif
 
 # Go-gapps
 ifeq ($(BLISS_BUILD_VARIANT), goapps)
