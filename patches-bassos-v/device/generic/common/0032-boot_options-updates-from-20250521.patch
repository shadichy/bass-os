       description: "PWR_OFF_DBLCLK=1"
+    - name: "Set power non-boot CPU off (0,1)"
+      description: "PWR_NON_BOOT_CPU="
+      editable: true
+      default: "1 "
+    - name: "Ignore default display sleep"
+      description: "IGNORE_DEFAULT_DISPLAY_SLEEP=true"
