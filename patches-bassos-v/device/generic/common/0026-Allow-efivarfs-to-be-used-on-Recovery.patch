---
 properties/vendor.prop | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/properties/vendor.prop b/properties/vendor.prop
index 043af86..8101f24 100644
--- a/properties/vendor.prop
+++ b/properties/vendor.prop
@@ -5,4 +5,4 @@ vendor.recovery.dhcpclient.iface?=eth0
 ro.surface_flinger.enable_frame_rate_override=false
 
 # Recovery
-ro.recovery.supported_fs=9p,virtiofs
+ro.recovery.supported_fs=9p,virtiofs,efivarfs
