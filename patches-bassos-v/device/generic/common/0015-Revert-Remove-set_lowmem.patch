From 19245e6a211f69ac6a3286203825d2995f339306 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Tue, 15 Apr 2025 09:26:03 -0400
Subject: [PATCH 15/19] Revert "Remove set_lowmem"

This reverts commit f414ca9433ee6a27f1773e7e29737f314a672d50.
---
 init.sh | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/init.sh b/init.sh
index 6c0ffa9..6c97035 100644
--- a/init.sh
+++ b/init.sh
@@ -858,6 +858,21 @@ function init_cpu_governor()
 	}
 }
 
+function set_lowmem()
+{
+	# 512 MB size in kB : https://source.android.com/devices/tech/perf/low-ram
+	SIZE_512MB=2048000
+
+	mem_size=`cat /proc/meminfo | grep MemTotal | tr -s ' ' | cut -d ' ' -f 2`
+
+	if [ "$mem_size" -le "$SIZE_512MB" ]
+	then
+		setprop ro.config.low_ram true
+	else
+		setprop ro.config.low_ram false
+	fi
+}
+
 function set_custom_ota()
 {
 	for c in `cat /proc/cmdline`; do
@@ -911,6 +926,7 @@ function set_custom_timezone()
 function do_init()
 {
 	init_misc
+	set_lowmem
 	set_custom_timezone
 	init_hal_audio
 	set_custom_ota
-- 
