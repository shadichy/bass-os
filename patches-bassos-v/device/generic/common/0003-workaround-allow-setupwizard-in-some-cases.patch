From 3068ff605f61fc63e1e1e259817a286d31017261 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Tue, 21 Jan 2025 17:36:57 -0500
Subject: [PATCH 03/42] workaround: allow setupwizard in some cases

---
 device.mk   | 7 ++++++-
 init.sh     | 2 +-
 init.x86.rc | 1 -
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/device.mk b/device.mk
index fe05b06..40f5d96 100644
--- a/device.mk
+++ b/device.mk
@@ -60,10 +60,15 @@ PRODUCT_PROPERTY_OVERRIDES := \
     audio.safemedia.bypass=true \
     persist.device_config.mglru_native.lru_gen_config=all \
     persist.sys.zram_enabled=1 \
-    ro.setupwizard.mode=DISABLED \
     external_storage.casefold.enabled=1 \
     external_storage.projid.enabled=1
 
+
+ifneq ($(USE_BLISS_SETUPWIZARD),true)
+    PRODUCT_PROPERTY_OVERRIDES += \
+        ro.setupwizard.mode=DISABLED
+endif
+
 PRODUCT_COPY_FILES := \
     $(if $(wildcard $(PRODUCT_DIR)init.rc),$(PRODUCT_DIR)init.rc:root/init.rc) \
     $(if $(wildcard $(PRODUCT_DIR)init.sh),$(PRODUCT_DIR),$(LOCAL_PATH)/)init.sh:system/etc/init.sh \
diff --git a/init.sh b/init.sh
index 2ffb5fc..1cae568 100644
--- a/init.sh
+++ b/init.sh
@@ -1061,7 +1061,7 @@ for c in `cat /proc/cmdline`; do
 						set_property persist.bliss.disable_recents "$FORCE_DISABLE_RECENTS"
 						;;
 				esac
-				[ "$SETUPWIZARD" = "0" ] && set_property ro.setupwizard.mode DISABLED
+				[ "$SETUPWIZARD" = "0" ] && set_property ro.setupwizard.mode DISABLED && set_property app.setupwizard.disable 0
 			fi
 			;;
 	esac
diff --git a/init.x86.rc b/init.x86.rc
index 0220b3b..529b583 100644
--- a/init.x86.rc
+++ b/init.x86.rc
@@ -74,7 +74,6 @@ on boot
 
     # merge from system.prop
     setprop ro.config.sync yes
-    setprop app.setupwizard.disable 0
     setprop ro.alarm.volume.adjustable true
     setprop ro.simulated.phone false
     # disable red frame boarder in eng build
-- 
2.43.0

