From 60eec0d35555208c4ed9a7651d5fbc34ad57c1ff Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Mon, 7 Apr 2025 13:49:41 -0400
Subject: [PATCH 10/42] allow switch for system image type

This allows us to set the config on build time
USE_SQUASHFS or USE_EROFS
---
 BoardConfig.mk | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index c00b42c..7bffdbd 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -7,8 +7,13 @@ TARGET_BOARD_PLATFORM := android-x86
 LOCAL_COMMON_TREE := device/generic/common
 
 ## Switch to EROFS image instead of Squashfs
-USE_SQUASHFS := 0
-USE_EROFS := 1
+ifneq ($(USE_SQUASHFS),1)
+	USE_SQUASHFS := 0
+endif
+
+ifneq ($(USE_EROFS),1)
+	USE_EROFS := 1
+endif
 
 # Architecture
 TARGET_CPU_VARIANT := generic
-- 
