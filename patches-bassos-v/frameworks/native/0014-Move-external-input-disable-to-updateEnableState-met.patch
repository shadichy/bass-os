From 5386117d86e75aff834206c9c25232da9cff4bf3 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Mon, 5 May 2025 09:20:16 -0400
Subject: [PATCH 14/14] Move external input disable to updateEnableState method

---
 services/inputflinger/reader/InputDevice.cpp | 41 +++++++++-----------
 1 file changed, 19 insertions(+), 22 deletions(-)

diff --git a/services/inputflinger/reader/InputDevice.cpp b/services/inputflinger/reader/InputDevice.cpp
index 7f94ee7b5b..c993dbc7aa 100644
--- a/services/inputflinger/reader/InputDevice.cpp
+++ b/services/inputflinger/reader/InputDevice.cpp
@@ -71,6 +71,15 @@ std::list<NotifyArgs> InputDevice::updateEnableState(nsecs_t when,
                                                      const InputReaderConfiguration& readerConfig,
                                                      bool forceEnable) {
     bool enable = forceEnable;
+
+    // Allow blocking external device input
+    char mIgnoreExternalInput[PROPERTY_VALUE_MAX] = {0};
+    property_get("ro.boot.force.ignore_external_input", mIgnoreExternalInput, "0");
+
+    // Allow blocking external touch input
+    char mIgnoreExternalTouch[PROPERTY_VALUE_MAX] = {0};
+    property_get("ro.boot.force.ignore_external_touch", mIgnoreExternalTouch, "0");
+
     if (!forceEnable) {
         // If the device was explicitly disabled by the user, it would be present in the
         // "disabledDevices" list. This device should be disabled.
@@ -87,6 +96,16 @@ std::list<NotifyArgs> InputDevice::updateEnableState(nsecs_t when,
                   "with %s, but the corresponding viewport is not found",
                   getName().c_str(), desc.c_str());
             enable = false;
+        } else if (strcmp(mIgnoreExternalInput, "1") == 0) {
+            if (mIsExternal) {
+                enable = false;
+            }
+        } else if (strcmp(mIgnoreExternalTouch, "1") == 0) {
+            if (mIsExternal) {
+                if ((mClasses.test(InputDeviceClass::TOUCH)) || (mClasses.test(InputDeviceClass::TOUCH_MT))) {
+                    enable = false;
+                }
+            }
         }
     }
 
@@ -254,14 +273,6 @@ std::list<NotifyArgs> InputDevice::configureInternal(nsecs_t when,
 
     using Change = InputReaderConfiguration::Change;
 
-    // Allow blocking external device input
-    char mIgnoreExternalInput[PROPERTY_VALUE_MAX] = {0};
-    property_get("ro.boot.force.ignore_external_input", mIgnoreExternalInput, "0");
-
-    // Allow blocking external touch input
-    char mIgnoreExternalTouch[PROPERTY_VALUE_MAX] = {0};
-    property_get("ro.boot.force.ignore_external_touch", mIgnoreExternalTouch, "0");
-
     if (!changes.any() || !isIgnored()) {
         // Full configuration should happen the first time configure is called
         // and when the device type is changed. Changing a device type can
@@ -344,7 +355,6 @@ std::list<NotifyArgs> InputDevice::configureInternal(nsecs_t when,
 
             // If it is associated with a specific display, then find the corresponding viewport
             // which will be used to enable/disable the device.
-            bool enabled = (readerConfig->disabledDevices.find(mId) == readerConfig->disabledDevices.end());
             if (mAssociatedDisplayPort) {
                 mAssociatedViewport =
                         readerConfig.getDisplayViewportByPort(*mAssociatedDisplayPort);
@@ -352,7 +362,6 @@ std::list<NotifyArgs> InputDevice::configureInternal(nsecs_t when,
                     ALOGW("Input device %s should be associated with display on port %" PRIu8 ", "
                           "but the corresponding viewport is not found.",
                           getName().c_str(), *mAssociatedDisplayPort);
-                    enabled = false;
                 }
             } else if (mAssociatedDisplayUniqueIdByDescriptor != std::nullopt) {
                 mAssociatedViewport = readerConfig.getDisplayViewportByUniqueId(
@@ -361,7 +370,6 @@ std::list<NotifyArgs> InputDevice::configureInternal(nsecs_t when,
                     ALOGW("Input device %s should be associated with display %s but the "
                           "corresponding viewport cannot be found",
                           getName().c_str(), mAssociatedDisplayUniqueIdByDescriptor->c_str());
-                    enabled = false;
                 }
             } else if (mAssociatedDisplayUniqueIdByPort != std::nullopt) {
                 mAssociatedViewport = readerConfig.getDisplayViewportByUniqueId(
@@ -370,17 +378,6 @@ std::list<NotifyArgs> InputDevice::configureInternal(nsecs_t when,
                     ALOGW("Input device %s should be associated with display %s but the "
                           "corresponding viewport cannot be found",
                           getName().c_str(), mAssociatedDisplayUniqueIdByPort->c_str());
-                    enabled = false;
-                }
-            } else if (strcmp(mIgnoreExternalInput, "1") == 0) {
-                if (mIsExternal) {
-                    enabled = false;
-                }
-            } else if (strcmp(mIgnoreExternalTouch, "1") == 0) {
-                if (mIsExternal) {
-                    if ((mClasses.test(InputDeviceClass::TOUCH)) || (mClasses.test(InputDeviceClass::TOUCH_MT))) {
-                        enabled = false;
-                    }
                 }
             }
 
