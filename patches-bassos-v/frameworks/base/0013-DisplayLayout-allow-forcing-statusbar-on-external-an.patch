From 457b9f6dfe4a218939e28bb4e97b8ca3b19f8e61 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Mon, 20 Jan 2025 12:50:55 -0500
Subject: [PATCH 13/28] DisplayLayout: allow forcing statusbar on external and
 virtual displays

---
 .../Shell/src/com/android/wm/shell/common/DisplayLayout.java  | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/common/DisplayLayout.java b/libs/WindowManager/Shell/src/com/android/wm/shell/common/DisplayLayout.java
index 2186c1d6a117..4b46f006d28f 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/common/DisplayLayout.java
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/common/DisplayLayout.java
@@ -457,6 +457,10 @@ public class DisplayLayout {
         // Allow a system property to override this. Used for kiosk mode.
         if (SystemProperties.getBoolean("persist.bliss.disable_statusbar", false)) {
             return false;
+        } else if (displayId == Display.TYPE_EXTERNAL && SystemProperties.getBoolean("persist.bliss.enable_external_statusbar", false)) {
+            return true;
+        } else if (displayId == Display.TYPE_VIRTUAL && SystemProperties.getBoolean("persist.bliss.enable_virtual_statusbar", false)) {
+            return true;
         } else if (displayId == Display.DEFAULT_DISPLAY) {
             return displayId == Display.DEFAULT_DISPLAY;
         } else {
