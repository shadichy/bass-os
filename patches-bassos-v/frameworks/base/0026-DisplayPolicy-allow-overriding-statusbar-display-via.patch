From: Jon West <electrikjesus@gmail.com>
Date: Tue, 31 Dec 2024 15:07:34 -0500
Subject: [PATCH 26/42] DisplayPolicy: allow overriding statusbar display via
 prop

---
 services/core/java/com/android/server/wm/DisplayPolicy.java | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/services/core/java/com/android/server/wm/DisplayPolicy.java b/services/core/java/com/android/server/wm/DisplayPolicy.java
index 1a2425b60b21..0a5f00ff4d7a 100644
--- a/services/core/java/com/android/server/wm/DisplayPolicy.java
+++ b/services/core/java/com/android/server/wm/DisplayPolicy.java
@@ -220,6 +220,9 @@ public class DisplayPolicy {
      */
     private boolean mRemoteInsetsControllerControlsSystemBars;
 
+    // Check the system property to disable the status bar by default
+    private boolean disableStatusBarByDefault = SystemProperties.getBoolean("persist.bliss.disable_statusbar", false);
+
     StatusBarManagerInternal getStatusBarManagerInternal() {
         synchronized (mServiceAcquireLock) {
             if (mStatusBarManagerInternal == null) {
@@ -2280,6 +2283,9 @@ public class DisplayPolicy {
             // No transient mode on lockscreen (in notification shade window).
             return;
         }
+        if (disableStatusBarByDefault && swipeTarget == mStatusBar) {
+            return;
+        }
 
         if (controlTarget != null) {
             final WindowState win = controlTarget.getWindow();
